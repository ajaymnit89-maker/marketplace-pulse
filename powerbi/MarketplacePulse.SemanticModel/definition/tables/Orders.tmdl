table Orders
	lineageTag: 81a83076-b67b-4577-93ae-8d0fe3640a7a

	/// Item price + freight, excluding canceled orders (dbt metrics.md).
	measure GMV = CALCULATE(SUM(Orders[order_value]), Orders[is_canceled] = FALSE())
		formatString: "R$"#,0
		displayFolder: Sales
		lineageTag: b8e815d3-e824-4fb9-a696-19486cc8d217

	/// Orders excluding canceled.
	measure 'Order Count' = CALCULATE(COUNTROWS(Orders), Orders[is_canceled] = FALSE())
		formatString: #,0
		displayFolder: Sales
		lineageTag: 3721f691-f82d-4827-ad0c-3c74e3e8dd31

	/// GMV / Orders.
	measure AOV = DIVIDE([GMV], [Order Count])
		formatString: "R$"#,0.00
		displayFolder: Sales
		lineageTag: 54da585b-b7a5-48fd-b86a-dea8c997fdb5

	/// GMV vs the same period last year.
	measure 'GMV YoY %' = VAR prev = CALCULATE([GMV], SAMEPERIODLASTYEAR('Date'[date_day])) RETURN DIVIDE([GMV] - prev, prev)
		formatString: 0.0%
		displayFolder: Sales
		lineageTag: 75ced273-3c3b-41e8-bd19-8e5ba38b8d50

	measure 'Freight % of GMV' = DIVIDE(CALCULATE(SUM(Orders[freight_value]), Orders[is_canceled] = FALSE()), [GMV])
		formatString: 0.0%
		displayFolder: Sales
		lineageTag: 98edac21-5f81-446e-8ed6-1d46c05be7ea

	measure 'Delivered Orders' = CALCULATE(COUNTROWS(Orders), Orders[is_delivered] = TRUE(), Orders[is_canceled] = FALSE())
		formatString: #,0
		displayFolder: Delivery
		lineageTag: fda4008f-d207-47c2-8196-5a875a6f148a

	/// Delivered on a calendar day after the promised date.
	measure 'Late Orders' = CALCULATE(COUNTROWS(Orders), Orders[is_late] = TRUE(), Orders[is_canceled] = FALSE())
		formatString: #,0
		displayFolder: Delivery
		lineageTag: c786345f-8f0c-49d5-8cc3-b866bff851e3

	measure 'Late Rate' = DIVIDE([Late Orders], [Delivered Orders])
		formatString: 0.0%
		displayFolder: Delivery
		lineageTag: b9a43478-a57e-4ae5-a69e-03d4dd398169

	measure 'On-time Rate' = DIVIDE([Delivered Orders] - [Late Orders], [Delivered Orders])
		formatString: 0.0%
		displayFolder: Delivery
		lineageTag: f4130710-2bcb-40b4-8f1a-35a1b1bb1736

	measure 'Avg Delay Days (Late)' = CALCULATE(AVERAGE(Orders[delay_days]), Orders[is_late] = TRUE(), Orders[is_canceled] = FALSE())
		formatString: 0.0
		displayFolder: Delivery
		lineageTag: b2747e17-a16f-46b5-83ff-84c2f0cb0e19

	measure 'Avg Delivery Days' = CALCULATE(AVERAGE(Orders[delivery_days]), Orders[is_delivered] = TRUE(), Orders[is_canceled] = FALSE())
		formatString: 0.0
		displayFolder: Delivery
		lineageTag: bc0da620-944b-4e20-9887-1380487c243c

	measure 'Late GMV' = CALCULATE([GMV], Orders[is_late] = TRUE())
		formatString: "R$"#,0
		displayFolder: Delivery
		lineageTag: 42b0063b-96ae-4126-91a3-b78c0496f2d2

	/// Items handed to the carrier after the seller's shipping deadline.
	measure 'Seller Late-ship Rate' = DIVIDE(CALCULATE(COUNTROWS('Order Items'), 'Order Items'[seller_shipped_late] = TRUE()), CALCULATE(COUNTROWS('Order Items'), NOT ISBLANK('Order Items'[seller_shipped_late])))
		formatString: 0.0%
		displayFolder: Delivery
		lineageTag: e2f43b8a-ceaa-47e5-b1b3-1d942456b62f

	measure 'Avg Review Score' = CALCULATE(AVERAGE(Orders[review_score]), Orders[is_canceled] = FALSE())
		formatString: 0.00
		displayFolder: Customer
		lineageTag: 16847e77-c370-42d4-ae73-4b62cd81f37b

	/// Share of reviewed orders rated 1-2 stars. Blank scores are excluded explicitly: DAX treats BLANK <= 2 as true.
	measure 'Bad Review Share' = VAR reviewed = FILTER(Orders, NOT ISBLANK(Orders[review_score]) && Orders[is_canceled] = FALSE()) RETURN DIVIDE(COUNTROWS(FILTER(reviewed, Orders[review_score] <= 2)), COUNTROWS(reviewed))
		formatString: 0.0%
		displayFolder: Customer
		lineageTag: 6e2ddc60-ac88-45c7-8b44-b3388ed7a5e6

	measure Customers = DISTINCTCOUNT(Orders[customer_unique_id])
		formatString: #,0
		displayFolder: Customer
		lineageTag: 70daafcd-56df-4ca0-8ef6-cf2fcfb2079b

	measure 'Repeat Customer Rate' = DIVIDE(CALCULATE(COUNTROWS(Customer), Customer[is_repeat_customer] = TRUE()), COUNTROWS(Customer))
		formatString: 0.0%
		displayFolder: Customer
		lineageTag: 949616b3-d194-45fe-86fd-8418f4f584da

	/// Mean predicted late probability (LightGBM).
	measure 'Avg Late Risk' = AVERAGE('Late Risk'[late_risk])
		formatString: 0.0%
		displayFolder: ML & AI
		lineageTag: 2c9f4fca-717b-4f19-acc7-de7ea442661a

	/// 1-2 star reviews labelled by Claude.
	measure 'Classified Reviews' = COUNTROWS('Review Insight')
		formatString: #,0
		displayFolder: ML & AI
		lineageTag: 46f8f9ac-c588-4179-8581-6777c22196f5

	measure 'Review Topic Share' = DIVIDE([Classified Reviews], CALCULATE([Classified Reviews], ALL('Review Insight'[topic])))
		formatString: 0.0%
		displayFolder: ML & AI
		lineageTag: f85714b7-65fb-4445-8ad2-6a1d3bcab500

	measure 'Forecast Orders' = SUM(Forecast[forecast])
		formatString: #,0
		displayFolder: ML & AI
		lineageTag: 429f338c-1cde-426d-b6a9-843c3937ee4c

	measure 'Actual Orders (Forecast)' = SUM(Forecast[actual_orders])
		formatString: #,0
		displayFolder: ML & AI
		lineageTag: 7efd79f8-eae6-460b-8ba1-d4836e1cef30

	column order_id
		dataType: string
		lineageTag: f1513cc8-f57d-47df-9dd5-feecf9cb98fa
		sourceColumn: order_id

	column customer_unique_id
		dataType: string
		lineageTag: a2c9385a-04b7-4b30-bf0e-73d23f8777e9
		sourceColumn: customer_unique_id

	column customer_state
		dataType: string
		lineageTag: 2d09a171-8ca7-43a3-9e3d-82694c006d9f
		sourceColumn: customer_state

	column order_status
		dataType: string
		lineageTag: f9754a58-c211-474d-92ac-cfc2d0634f33
		sourceColumn: order_status

	column is_canceled
		dataType: boolean
		lineageTag: 555b3abe-d3b6-409a-8aee-949c99a7d7e2
		sourceColumn: is_canceled

	column purchase_date
		dataType: dateTime
		lineageTag: 78bd03cd-bb19-42d9-8f5e-109618c683ad
		sourceColumn: purchase_date

	column is_delivered
		dataType: boolean
		lineageTag: 5cbcdeba-950b-4b36-bbad-e6db7cf891d6
		sourceColumn: is_delivered

	column delivery_days
		dataType: int64
		lineageTag: 7311ea14-f51d-44ec-b338-7dbe12c7146f
		sourceColumn: delivery_days

	column promised_days
		dataType: int64
		lineageTag: 76ce63a8-b325-4560-b109-85da77e5070a
		sourceColumn: promised_days

	column delay_days
		dataType: int64
		lineageTag: 67cb85ca-44a1-499b-b11b-ef88810d5cb3
		sourceColumn: delay_days

	column is_late
		dataType: boolean
		lineageTag: 30b524ff-fa1d-4068-a213-45702e014ee6
		sourceColumn: is_late

	column item_count
		dataType: int64
		lineageTag: 679bfdc1-d68e-44f3-9c85-1a7375d1b20b
		sourceColumn: item_count

	column order_value
		dataType: double
		lineageTag: 15bd4b26-9b23-44dd-b2ac-0d1e39ed3cde
		sourceColumn: order_value

	column freight_value
		dataType: double
		lineageTag: 4ee2bf0f-7a0d-4eb6-9ab8-131c8a1ae5c2
		sourceColumn: freight_value

	column payment_value
		dataType: double
		lineageTag: 6ae382f0-0688-49ff-ba18-18b3b37e6892
		sourceColumn: payment_value

	column main_payment_type
		dataType: string
		lineageTag: 7f6ac310-9c0b-45e9-ab2e-926d789dbdf8
		sourceColumn: main_payment_type

	column review_score
		dataType: int64
		lineageTag: 7718eda3-42e5-4a31-a193-f2f7cbeeb2c6
		sourceColumn: review_score

	column customer_order_number
		dataType: int64
		lineageTag: cc8fd9df-68f8-4166-a3a4-9ee0572d19da
		sourceColumn: customer_order_number

	/// Delivered date vs promised date, bucketed. Blank if not delivered.
	column 'Delay Bucket' = SWITCH(TRUE(), ISBLANK(Orders[delay_days]), BLANK(), Orders[delay_days] <= -7, "7+ days early", Orders[delay_days] <= 0, "0-6 days early", Orders[delay_days] <= 3, "1-3 days late", Orders[delay_days] <= 7, "4-7 days late", "8+ days late")
		dataType: string
		lineageTag: 692075b0-d3c9-4816-95b2-9116b8960b66
		sortByColumn: 'Delay Bucket Order'

	column 'Delay Bucket Order' = SWITCH(TRUE(), ISBLANK(Orders[delay_days]), BLANK(), Orders[delay_days] <= -7, 1, Orders[delay_days] <= 0, 2, Orders[delay_days] <= 3, 3, Orders[delay_days] <= 7, 4, 5)
		dataType: int64
		isHidden
		lineageTag: 60b357d5-faaa-42cb-b512-dd1500bff21e

	partition Orders = m
		mode: import
		source = let Source = Parquet.Document(File.Contents(DataFolder & "marts__fct_orders.parquet")), Kept = Table.SelectColumns(Source, {"order_id", "customer_unique_id", "customer_state", "order_status", "is_canceled", "purchase_date", "is_delivered", "delivery_days", "promised_days", "delay_days", "is_late", "item_count", "order_value", "freight_value", "payment_value", "main_payment_type", "review_score", "customer_order_number"}) in Kept

