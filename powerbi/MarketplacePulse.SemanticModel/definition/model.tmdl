model MarketplacePulse
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_ProTooling = ["MCP-PBIModeling"]

ref table Orders
ref table 'Order Items'
ref table Customer
ref table Seller
ref table Product
ref table Date
ref table 'Late Risk'
ref table 'Customer Segment'
ref table 'Review Insight'
ref table Forecast

